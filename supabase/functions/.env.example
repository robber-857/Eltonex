# Copy these custom variables into Supabase > Edge Functions > Secrets.
# Use the actual Vercel production URL (no trailing slash).
PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
# Optional extra exact origins, separated by commas. No wildcard previews.
ALLOWED_ORIGINS=
# Optional at first: enquiries save even while email is not configured.
RESEND_API_KEY=
MAIL_FROM=ELTONEX <enquiries@YOUR-VERIFIED-DOMAIN>
NOTIFY_EMAIL=eltonw482@gmail.com
# Supabase injects SUPABASE_URL and its API keys automatically.
