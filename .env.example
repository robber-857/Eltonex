# Copy to .env. Never commit .env or paste credentials into the browser.
PORT=4174
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:4174
NODE_ENV=development
DATA_DIR=./data
ADMIN_EMAIL=eltonw482@gmail.com
# Generate with npm run admin:password (interactive, masked input).
ADMIN_PASSWORD_HASH=
# Optional SMTP notification. Without this, enquiries are still saved in Admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=eltonw482@gmail.com
# Set only to the exact number of trusted reverse proxies in production.
TRUST_PROXY_HOPS=0
